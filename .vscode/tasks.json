{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ensure Build Folder",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/code/build",
      "problemMatcher": []
    },
    {
      "label": "CMake",
      "options": {
        "cwd": "${workspaceFolder}/code/build"
      },
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug ..",
      "problemMatcher": ["$gcc"],
      "dependsOn": "Ensure Build Folder"
    },
    {
      "label": "Build",
      "options": {
        "cwd": "${workspaceFolder}/code/build"
      },
      "type": "shell",
      "command": "make -j 4",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "dependsOn": "CMake"
    }
  ]
}
